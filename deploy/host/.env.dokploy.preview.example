CONTROL_PLANE_IMAGE=ghcr.io/<owner>/<repo>/control-plane:preview

# External Postgres
# Keep only `DATABASE_URL` for PostgreSQL after moving DB out of the app.
# Remove old bundled PG vars like `POSTGRES_DB`, `POSTGRES_USER`, `POSTGRES_PASSWORD`,
# and any `/var/lib/postgresql/data` volume from the app container.
OXMUX_BUNDLED_POSTGRES_ENABLED=false
DATABASE_URL=postgres://oxmux:replace-with-strong-password@oxmux-preview-db:5432/oxmux_preview

# Cloudflare R2 object storage
# Use the R2 S3 API endpoint, not a public/custom domain.
OXMUX_BUNDLED_OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=oxmux-preview
OBJECT_STORAGE_ACCESS_KEY_ID=replace-preview-r2-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-preview-r2-secret-key

# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=8989
OXMUX_PUBLIC_BASE_URL=https://your-domain.com
OXMUX_PROJECT_PREVIEW_BASE_DOMAIN=<your-preview-wildcard-root-domain>
OXMUX_PROJECT_PREVIEW_SCHEME=https
OXMUX_NODE_ID=node-1
OXMUX_NODE_NAME=node-1
OXMUX_NODE_URL=https://node-1.internal.example.com
OXMUX_NODE_RELAY_URL=https://node-1.internal.example.com
OXMUX_NODE_REGION=us-east-1
OXMUX_CLUSTER_TOKEN=<same-random-secret-on-all-nodes>
# Cloudflare Load Balancer monitor path: /api/ready
# Optional: multi-region worker routing
# OXMUX_EXECUTOR_ROUTE_RULES_JSON=[{"id":"us","cloudUrl":"https://us.example.com","labels":["route:us","realtime:us"],"continents":["NA"]},{"id":"eu","cloudUrl":"https://eu.example.com","labels":["route:eu","realtime:eu"],"continents":["EU"]}]
# OXMUX_DOMESTIC_REALTIME_BASE_URL=https://us.example.com
# OXMUX_DOMESTIC_EXECUTOR_LABELS=route:us,realtime:us
OXMUX_WORKER_CONSOLE_URL=

OXMUX_ENV=preview

# Community usage telemetry: preview/staging instances must not pollute community install stats.
OXMUX_USAGE_REPORTING_DISABLED=1

# 邮件发送（可选；不配置则注册无需邮箱验证，直接成功）
# 配置后：邮箱注册会发送验证邮件并要求验证；忘记密码可发重置邮件。
# 只填 EMAIL_PROVIDER=cloudflare 而留空凭据时，视为未配置（安全回退）。
EMAIL_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMAIL_FROM=noreply@example.com

# AI 运维健康检查（可选）
# 配置后 /api/health/detailed 需要 x-health-token 头（或 ?token=）才能访问
OXMUX_HEALTH_TOKEN=

# Secrets
# Required in production-like preview deploys. Every control-plane node must share the same value.
TOKEN_SECRET=<openssl-rand-hex-32>
GIT_CREDENTIAL_KEY=<openssl-rand-hex-32>

# Auth
BETTER_AUTH_SECRET=<openssl-rand-hex-32>
TURNSTILE_COOKIE_SECRET=<openssl-rand-hex-32>
BETTER_AUTH_URL=https://your-domain.com
BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
